# 复制为 .env 后修改：cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交真实密码

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
# MySQL root 密码（仅容器内部使用）
MYSQL_ROOT_PASSWORD=change-me-root-password

# 应用数据库与账号
MYSQL_DATABASE=hmdp
MYSQL_USER=hmdp
MYSQL_PASSWORD=change-me-app-password

# ---------------------------------------------------------------------------
# 镜像仓库
# ---------------------------------------------------------------------------
# 镜像名前缀。推送到腾讯云 TCR 个人版时填写：
#   IMAGE_REGISTRY=ccr.ccs.tencentyun.com/<你的命名空间>
# 不推仓库（只在本机构建运行）时填 local
IMAGE_REGISTRY=local

# 镜像标签。建议用版本号或时间戳，别永远 latest —— 要回滚时才知道该指回哪个
TAG=latest
