# ============================================================================
#  DianPing（黑马点评）  仓库根 .gitignore
# ----------------------------------------------------------------------------
#  5 条前提：
#   1. 只对【还没被 Git 跟踪】的文件生效。已 commit 过的要先退出跟踪：
#        git rm --cached <路径>          （--cached = 只从索引删，不动磁盘文件）
#   2. 路径以本文件所在目录（仓库根）为基准；/ 开头表示只在根目录匹配。
#   3. 子目录里的 .gitignore 会叠加，越靠近文件的优先级越高。
#   4. 同一文件内后写的规则覆盖先写的，! 反选必须写在忽略规则之后。
#   5. 父目录被排除时，子文件用 ! 捞不回来，必须先捞父目录。
#  排查某个文件被哪条规则命中：git check-ignore -v <路径>
# ============================================================================

# ---------------------------------------------------------------------------
#  1. 操作系统 / 编辑器垃圾
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.swp
*~
*.log

# ---------------------------------------------------------------------------
#  2. IDE / 工具链
# ---------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
/out/
/dist/
node_modules/

# ---------------------------------------------------------------------------
#  3. 压缩包（源码已经在仓库里，这些是冗余副本）
# ---------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ---------------------------------------------------------------------------
#  4. 本机私有配置  密码、密钥绝不能入库
# ---------------------------------------------------------------------------
*-local.yaml
*-local.yml
*-local.properties
# 所有 profile 配置默认忽略，只放行 *.example 模板，
# 防止哪天 application-prod.yaml 里写了数据库密码被一起提交
application-*.yaml
application-*.yml
application-*.properties
!application-*.yaml.example
!application-*.yml.example
!application-*.properties.example
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
#  5. backend/  Spring Boot 后端：构建产物 / 日志 / 转储
#     （backend/.gitignore 里也有一份，两份叠加生效）
# ---------------------------------------------------------------------------
backend/target/
backend/logs/
*.class
hs_err_pid*
*.hprof

# ---------------------------------------------------------------------------
#  6. frontend/  这个目录里装的是【nginx 运行环境 + 页面代码】
#     原则：nginx 发行包可随时重新下载  不入库
#           本项目真正定制过、运行必需的部分  入库
# ---------------------------------------------------------------------------
# nginx 可执行文件与自带资料
/frontend/nginx.exe
/frontend/contrib/
/frontend/docs/
# nginx 运行期产物：日志动辄几 MB，pid 每次都变
/frontend/logs/
/frontend/temp/
nginx.pid
# nginx 自带的默认首页不入库
# 注意：50x.html 不忽略，因为 nginx.conf 的 error_page 会用到它
/frontend/html/index.html
# nginx 自带的一堆默认配置，只留运行必需的
# 反选三段式：想捞回某个文件，必须先把父目录捞回来，否则无效
/frontend/conf/*
!/frontend/conf/nginx.conf
!/frontend/conf/mime.types
!/frontend/conf/fastcgi_params
!/frontend/conf/fastcgi.conf
!/frontend/conf/scgi_params
!/frontend/conf/uwsgi_params
!/frontend/conf/koi-utf
!/frontend/conf/koi-win
!/frontend/conf/win-utf

# 用户上传的图片 = 运行期测试数据，不入库。
#   注意：hmdp.sql 种子数据引用的 17 张样图也在这个目录下。
#   首次建仓时必须显式加回来（只需一次，之后会被持续跟踪）：
#       git add -f frontend/html/hmdp/imgs/blogs
#   因为父目录被整体排除，这里用 ! 反选是捞不回来的。
/frontend/html/hmdp/imgs/blogs/

# ---------------------------------------------------------------------------
#  7. 本地视觉验证产物（无头浏览器截图 / 预览脚本输出，不入库）
# ---------------------------------------------------------------------------
/.preview-shots/