# ---------------------------------------------------------------------------
# Docker 构建上下文排除项（构建上下文 = 仓库根目录）
# 目的：镜像更小、构建更快，且绝不把本机密码打进镜像
# ---------------------------------------------------------------------------

.git
.gitignore
.idea
.vscode
.deploy
.preview-shots

# 构建产物：镜像里由 Maven 重新构建
backend/target

# 文档与素材，运行镜像不需要
docs
others
*.md

# 本机私有配置（含数据库密码），绝不能进镜像
backend/src/main/resources/application-local.yaml
*.env

# 本地缓存
node_modules
**/*.log
